+        let circuit = Circuit::empty(circuit_version);
+        let vk = plonk::keygen_vk(&params, &circuit).map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, format!("{e:?}")))?;
+        Ok(VerifyingKey { params, vk, circuit_version })
     }
 
