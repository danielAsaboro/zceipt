{
  "name": "zcash-receipts",
  "version": "0.1.0",
  "description": "Verify Zcash payment receipts (ZIP 311 for Orchard and Ironwood) in the browser or Node. Prove one shielded payment, reveal nothing else.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./widget": "./widget.js",
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./middleware": {
      "types": "./middleware.d.ts",
      "default": "./middleware.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "grpc.js",
    "widget.js",
    "worker.js",
    "pkg/",
    "README.md",
    "react.js",
    "react.d.ts",
    "background.js",
    "middleware.js",
    "middleware.d.ts"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "zcash",
    "zip-311",
    "payment-disclosure",
    "privacy",
    "orchard",
    "ironwood",
    "receipt"
  ],
  "types": "./index.d.ts",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
